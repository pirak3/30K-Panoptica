            <modifier type="add" value="cf47-4aef-a6db-782d" field="category">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="9950-2cd2-fd88-9bb1" shared="true" includeChildSelections="true"/>
              </conditions>
            </modifier>
