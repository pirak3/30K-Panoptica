          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Legion Spatha combat bike that chooses to Run gains the Shrouded (5+) special rule until the start of the controlling player’s next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
