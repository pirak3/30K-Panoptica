        <infoLink name="Skilled Rider" id="deff-c942-e9e3-4505" hidden="false" type="rule" targetId="c329-5387-b535-113d"/>
      </infoLinks>
      <entryLinks>
        <entryLink id="fb88-d0e0-cbde-1da9" name="Scatterbolt Launcher" hidden="false" collective="false" import="true" targetId="2ad6-969c-a486-caa8" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="919e-1de1-492f-40c7" type="min"/>
