          <rules>
            <rule id="16de-c2ec-2de5-6b6b" name="Rally the Legion" hidden="false">
              <description>Once per battle, at the start of any of the controlling player&apos;s turns, this rule may be activated. Once activated, take a Leadership test for this model; if passed then all friendly units that are Pinned or Falling Back and have at least one model that can draw line of sight to the model with this special rule immediately rally, and are no longer Pinned or Falling Back and may act normally this turn.</description>
            </rule>
          </rules>
          <entryLinks>
            <entryLink id="6f5a-7c1c-989f-4f6c" name="Master of the Legion" hidden="false" collective="false" import="true" targetId="0068-6b0a-0086-3d6b" type="selectionEntry">
