    <selectionEntry id="2a2d-c6bf-5611-50e8" name="Saturnine Terminator Armour" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="15a4-d21f-16c5-f4cd" type="min"/>
