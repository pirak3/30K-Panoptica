    <selectionEntry id="59ee-ec19-30f2-ddfa" name="Aspectum-Pattern Occularis Array" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="f9cb-cf30-246d-2c2a" name="Aspectum-Pattern Occularis Array" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model armed with this wargear has the Night Vision Special Rule, and any enemy model targeted by a Shooting Attack from this model suffers a -1 penalty to all Cover Saves it makes as a result of attacks made by this model.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="7429-1925-7210-9485" name="Night Vision" hidden="false" targetId="683e-b4f2-f032-d31b" type="rule"/>
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="63c4-c6bc-f28d-da92" name="Atomantic Dispersion Shield" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="8139-a65a-1620-7fa0" name="Atomantic Dispersion Shield" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model armed with this wargear has a 5+ Invulnerable Save - but this can never be improved by any effects of Wargear, Special Rules, or Psychic Powers.

In addition, when a model with an Atomantic Dispersion Shield loses its last Hull Point, increase the explosion radius by 3”.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="c13e-10ec-96a1-c0b2" name="Full-Spectra Comms Array" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="189a-0cbe-215c-808a" name="Full-Spectra Comms Array" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Full-Spectra Comms Array counts as an Augury Scanner, Nuncio Vox, and Vox Disruptor Array, as well as granting the following bonuses:

A model equipped with a Full-Spectra Comms Array has the Night Vision Special Rule.

In the Shooting Phase, a model equipped with a Full-Spectra Comms Array may grant a single friendly unit within 3” +1 to their BS for that Shooting Phase. This benefit is not cumulative and cannot be stacked with the bonus provided by a Cognis Signum.

In addition, at the start of your turn, a Pater Consularis Master of Signals may grant a single friendly unit within 3” the ability to ignore the -1 penalty to Leadership imposed by the Night Fighting rules until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="aafa-3a60-794e-3964" name="Night Vision" hidden="false" targetId="683e-b4f2-f032-d31b" type="rule"/>
      </infoLinks>
      <entryLinks>
        <entryLink id="25f6-4866-82a1-1f9d" name="Augury Scanner" hidden="false" collective="false" import="true" targetId="67ee-7338-3b74-04b4" type="selectionEntry">
