            <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 1, Pinning, Deflagrate, Shell, Shock (3), Psychic Focus</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="6b3c-9fc9-7911-91f6" name="Pinning" hidden="false" targetId="1c96-205c-59a0-3cf2" type="rule"/>
        <infoLink id="84a0-c607-a1e4-24bf" name="Deflagrate" hidden="false" targetId="60bc-f79a-67ae-be4f" type="rule"/>
