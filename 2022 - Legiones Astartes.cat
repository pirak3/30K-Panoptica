                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dc6a-d925-ad60-d6b2" type="min"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="11d9-333f-95f4-0adf" name="Augurs of Weakness" publicationId="817a-6288-e016-7469" page="161" hidden="false" collective="false" import="true" type="upgrade">
                  <profiles>
                    <profile id="0638-e26a-2bbb-628f" name="Augurs of Weakness" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">When making an Armor Penetration roll against a target with Armour 11 or more on the facing targeted, a model with this special rule may add +1 to the Strength of the weapon used in the attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="c891-3932-b6f5-5d66" name="Icons of Resolve" publicationId="817a-6288-e016-7469" page="161" hidden="false" collective="false" import="true" type="upgrade">
                  <profiles>
                    <profile id="f304-068a-faab-17e4" name="Icons of Resolve" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model gains +1 Leadership (to a maximum of 10) on any turn in which it, or a unit it is part of, is Charged by one or more enemy units.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="1d55-8faa-84f9-7aa6" name="Slayers of Kings" publicationId="817a-6288-e016-7469" page="161" hidden="false" collective="false" import="true" type="upgrade">
                  <profiles>
                    <profile id="619b-7765-d39a-775d" name="Slayers of Kings" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll failed To Hit rolls of &apos;1&apos; when Engaged in combat with any model with a Weapon Skill of 5 or higher or in a Challenge with any model with a Weapon Skill of 5 or higher.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="bb1c-0134-a0ff-a758" name="Hunter of Beasts" publicationId="817a-6288-e016-7469" page="161" hidden="false" collective="false" import="true" type="upgrade">
                  <profiles>
                    <profile id="6c5e-e7fd-c4eb-d0f1" name="Hunter of Beasts" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll failed To Wound rolls of &apos;1&apos; when any enemy unit it is Engaged in combat with includes one or more models with a Toughness of 5, or any failed To Wound roll if the target&apos;s Toughness is 6 or higher.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="37ec-330f-d525-24d4" name="Reaper of Hosts" publicationId="817a-6288-e016-7469" page="161" hidden="false" collective="false" import="true" type="upgrade">
                  <profiles>
                    <profile id="478a-68bb-f32c-b29b" name="Reaper of Hosts" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model gains +1 Attack in any Fight sub-phase which they begin in base contact with more than one enemy model.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="0389-eebf-42ac-b9b6" name="Breaker of Witches" publicationId="817a-6288-e016-7469" page="161" hidden="false" collective="false" import="true" type="upgrade">
                  <profiles>
                    <profile id="0163-a212-d07e-34aa" name="Breaker of Witches" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll all To Hit and To Wound rolls in close combat when attacking an enemy unit that includes one or more models with the Daemon Unit Type or the Psyker or Corrupted Sub-type.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <entryLinks>
