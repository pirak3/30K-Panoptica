        <selectionEntry type="upgrade" import="true" name="Overseer" hidden="false" id="e9f2-f58a-6df3-5fdc">
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="25"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6381-09dc-1c8d-3ac6"/>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="5e23-3342-0a92-0b9a"/>
          </constraints>
          <infoLinks>
            <infoLink name="Support Squad" id="79bc-8ea0-0b47-f23e" hidden="true" targetId="768e-56d6-ca52-24ae" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Master of Auxilia" id="3b38-21a6-9d01-ea05" hidden="false" publicationId="d882-d2a-5da1-92c4" page="177">
              <description>Master of Auxilia: A model with this special rule must join a Solar Auxilia Rifle Section or Imperialis Militia Infantry Squad, chosen by the controlling player that was selected as an Overseer’s Retinue during deployment and once joined, may not voluntarily leave the unit during the course of any battle and may only join units selected through the use of the Overseer’s Retinue special rule. Whilst part of a unit selected as an Overseer’s Retinue, Wounds may not be allocated to the model with the Master of Auxilia special rule by the controlling player unless there are no other valid models in the targeted Overseer’s Retinue unit to allocate Wounds to. Additionally, a model with the Master of Auxilia special rule is considered to have the same variant of the Legiones Auxilia (X) special rule as the models in the unit that they have joined.</description>
            </rule>
            <rule name="Overseer’s Retinue" id="28ce-a016-b508-8823" hidden="false" publicationId="d882-d2a-5da1-92c4" page="177">
              <description>Overseer’s Retinue: An army that includes a model with this special rule may take a Tercio of 1-3 Solar Auxilia Rifle Sections or 1-3 Imperialis Militia Infantry Squads in accordance with the Strength in Numbers special rule*, as part of the same Force Organisation choice as the model with this special rule, as an Overseer’s Retinue. Note that any unit selected through the use of this special rule may not take any Dedicated Transport options.
Any Solar Auxilia Rifles Sections included through the use of the Overseer’s Retinue gain the Legiones Auxilia (X) special rule that corresponds with the Legiones Astartes (X) special rule that the Legion Overseer they share a Force Organisation choice with has. Additionally, all models in a Tercio selected as an Overseer’s Retinue use the Leadership Characteristic of the model with the Legiones Overseer special rule when ‘In Formation’.
* Note that rules for these units are found in the Warhammer: The Horus Heresy – Liber Imperium book or the Legacies of the Age of Darkness: the Imperialis Militia army list.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="25a2-7a52-632a-6b2c" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2bed-bdcf-cfe8-e3e8" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Alchymus" hidden="false" id="0a98-0119-a145-3fee">
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="35"/>
          </costs>
          <rules>
            <rule name="Alchem Munitions" id="b74c-5709-beff-326f" hidden="false">
              <description>The Alchymus, and any unit they join, gain the Poisoned (3+) Special Rule for all melee attacks, and the Fleshbane and Gets Hot Special Rules for all ranged attacks made with Bolt and Auto Weapons.</description>
            </rule>
            <rule name="Withering Aura" id="29d6-cb55-4b5a-107e" hidden="false">
              <description>Any model locked in a combat with an Alchymus which does not have the Legiones Astartes (Death Guard) Special Rule suffers a -1 penalty to their
Strength Characteristic for the duration of the combat.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="equalTo" value="0" field="selections" scope="force" childId="b5b7-3410-a8e5-95a6" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                    <condition type="equalTo" value="1" field="selections" scope="force" childId="dd1f-1c51-706c-e5f7" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" childName="XIV: Death Guard"/>
                    <condition type="instanceOf" value="0" field="selections" scope="ancestor" childId="25a2-7a52-632a-6b2c" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                    <condition type="equalTo" value="0" field="selections" scope="force" childId="ae4a-f95c-968e-eb46" shared="true" includeChildSelections="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2bed-bdcf-cfe8-e3e8" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
