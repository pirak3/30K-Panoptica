                  <profiles>
                    <profile id="53d3-282a-188f-500b" name="Mantle of Ultramar" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Mantle of Ultramar confers a 2+ Armour Save. In addition,  it grants the Battle-hardened (1) special rule to the model with it, and that model is not affected by the Blind special rule (however, any unit the model has joined is affected by Blind as normal).</characteristic>
                      </characteristics>
                    </profile>
