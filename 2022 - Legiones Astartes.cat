            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2bed-bdcf-cfe8-e3e8" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile id="5bb6-5abe-e59c-ac78" name="Fire Support" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">When making an attack with a Heavy weapon, a Castellan may increase the number of attacks made with that weapon by +1 when making a Shooting Attack (for example, a Castellan making a Shooting Attack with a Heavy 3 weapon would roll an additional dice for its attacks, rolling four dice in total). In addition, any Legion Heavy Support Squads in the same Detachment as a Castellan gain the Line Sub-type.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/>
          </costs>
          <categoryLinks>
            <categoryLink name="Legion Consularis:" hidden="false" id="72d5-75cf-a419-9d6b" targetId="4171-e276-e90d-b8e5" primary="false"/>
          </categoryLinks>
        </selectionEntry>
        <selectionEntry id="84ac-ebaf-8c66-3c1d" name="Dark Emissary" publicationId="09c5-eeae-f398-b653" page="285" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
