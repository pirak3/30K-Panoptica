    <selectionEntry id="a73b-1a97-49b0-b10d" name="Signum-Primus" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="221b-6a92-77c5-6442" name="Signum-Primus" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">In the Shooting Phase, a model equipped with a Signum-Primus may grant a single friendly unit with the same Legiones Astartes (X) Special Rule within 3” +1 to their BS for the duration of that Shooting Phase. This benefit is not cumulative and cannot be stacked with the bonus provided by a Cognis Signum.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
