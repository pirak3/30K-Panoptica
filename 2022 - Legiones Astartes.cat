        <entryLink import="true" name="Heavy Stubber" hidden="false" id="a0a-ea2e-6280-e90e" type="selectionEntry" targetId="f227-a61a-3215-932b" sortIndex="8">
          <modifiers>
            <modifier type="increment" value="1" field="929c-14bb-db46-a435">
              <repeats>
                <repeat value="3" repeats="1" field="selections" scope="unit" childId="model" shared="false" roundUp="false" includeChildSelections="true"/>
              </repeats>
            </modifier>
            <modifier type="set" value="true" field="hidden">
              <conditions>
