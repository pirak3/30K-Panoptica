      </constraints>
      <profiles>
        <profile id="cf95-3ca8-c3a5-cfb1" name="Arkhan Land" page="13" hidden="false" typeId="4bb2-cb95-e6c8-5a21" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="ddd7-6f5c-a939-b69e">Infantry (Cybertheurgist, Character, Line, Unique)</characteristic>
            <characteristic name="Move" typeId="893e-2d76-8f04-44e5">6</characteristic>
            <characteristic name="WS" typeId="cc42-7ed5-7092-5c84">4</characteristic>
            <characteristic name="BS" typeId="74ae-c840-0036-d244">5</characteristic>
            <characteristic name="S" typeId="e478-41d4-a092-48a8">4</characteristic>
            <characteristic name="T" typeId="c32b-5fdd-3fbe-9b1f">4</characteristic>
            <characteristic name="W" typeId="57ee-1126-32a9-5672">2</characteristic>
            <characteristic name="I" typeId="62d3-22d7-2d49-52dc">4</characteristic>
            <characteristic name="A" typeId="f111-2ce5-dd12-d6b0">2</characteristic>
            <characteristic name="Ld" typeId="e8a6-1da9-d384-8727">9</characteristic>
            <characteristic name="Save" typeId="e593-6b3c-f169-04f0">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="0f4c-4946-712f-4dfa" name="Master Cybertheurgist: Magister Machinis" page="13" hidden="false">
          <description>Arkhan Land has all the Rites and weapons that are part of the Artificia Machina and Artificia Cybernetica arcanas.</description>
        </rule>
        <rule id="1313-05e6-92be-9db7" name="High Techno-arcana: Technoarchaeologica" page="13" hidden="false">
          <description>If Arkhan Land is holding an objective marker at the start of the Controlling Player's turn, the Controlling Player may declare he will investigate it. If Arkhan does so, he may not Move or Charge during the Controlling Player's Turn, but may still shoot as normal. At the end of the turn, if Arkhan is within 3" of the objective marker, the Controlling Player gains 1 VP.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="3826-434f-b34f-2617" name="Battlesmith (X)" hidden="false" targetId="5d57-4d02-1e36-4a82" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Battlesmith (3+)"/>
          </modifiers>
        </infoLink>
