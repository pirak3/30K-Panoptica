              <profiles>
                <profile id="a585-1392-2e97-f032" name="Personal Void" page="15" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Koriel Zeth’s Personal Void grants her a 3+ Invulnerable Save, and allows her to ignore the first wound she suffers as the result of a failed Invulnerable Save during a battle.
In addition, it allows her to re-roll failed Characteristic tests other than Leadership tests, Psychic checks, or failed Dangerous Terrain tests.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
