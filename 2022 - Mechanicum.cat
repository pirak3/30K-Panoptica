        <selectionEntry id="127b-463c-07f4-e7cc" name="Warlord Trait: Accursed Scrapcode" page="16" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1f51-ec9b-0dee-b658" type="min"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="06e6-76f3-83c4-6ed8" type="max"/>
          </constraints>
          <profiles>
            <profile id="8022-8d68-7251-1275" name="Accursed Scrapcode" page="16" hidden="false" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">If your Warlord has this Trait, the Controlling Player may give up to three units in their army from the same detachment as the Warlord which are composed entirely of models with the Infantry, Monstrous, or Automata Unit Types the Corrupted Sub-type for no additional points cost during list construction. In addition, an army whose Warlord has this Trait gains two additional reactions to use during the Opposing Player's turn. They may use these in any combination (such as one each in the Movement and Shooting Phases, or both in the Assault Phase), but may only do so as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
