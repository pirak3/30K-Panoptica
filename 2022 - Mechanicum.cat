        <selectionEntry id="ee8c-67fc-3f4e-3e8e" name="Sapien" page="13" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f55a-3d9c-13de-f2d8" type="min"/>
