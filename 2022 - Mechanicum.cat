        <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b22b-fb92-ecfd-8a3e" type="max"/>
      </constraints>
      <rules>
        <rule id="dde6-fdf8-7e35-7786" name="Master Cybertheurgist: Domina Ignis" page="15" hidden="false">
          <description>Koriel Zeth has all the Rites and weapons that are part of the Artificia Machina and Ephemera Incursus arcanas.</description>
        </rule>
        <rule id="e88b-c253-829f-4712" name="High Techno-arcana: Noospherica" page="15" hidden="false">
          <description>All friendly models within 6" of Koriel Zeth which have the Cybernetica or Servitor Sub-types gain a bonus of +1 to their Hit rolls.
A single friendly unit with the Cybernetica Sub-type wholly within 12" of Koriel Zeth may be selected at the start of the Controlling Player’s Game Turn – this unit may ignore the restrictions applied on reacting by any Unit Type or Sub-type until the start of the Controlling Player’s next Game Turn.</description>
        </rule>
      </rules>
